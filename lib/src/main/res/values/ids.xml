<resources>
    <!--
      Stable id for AgentChatView. Android's view-state saving skips any view whose id is unset, so
      without this the view's own onSaveInstanceState/onRestoreInstanceState can never run and every
      host has to save and restore chat state by hand.
    -->
    <item name="sierra_agent_chat_view" type="id" />
</resources>
